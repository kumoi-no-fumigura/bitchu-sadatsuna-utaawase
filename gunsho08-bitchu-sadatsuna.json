 "poems": [
  {
   "seq": "1",
   "text": "神まして君が命のしるしあらは千とせをふるの社なりけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "かすしらす行末遠き君か代は鶴龜よりも久しかりけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春雨はぬるれとさらにいとはれす花さきそむる初とおもへは",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "しめ〓〓とふりくらすなる春雨は軒のしつくの絕るひまなし",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "あさまたきふる秋霧に夕されの春の霞はたちまさりけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "はれまなく夕のかすみたつおりは月なき夜半の心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "としことになきふるさとも春くれは猶めつらしき鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "としふれとみゝなれはせて鶯の聲きくことにめつらしき哉",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "さ夜更てはけしかるらしこち風の花さく宿はよきてふかなん",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "風の音の槇の板月にきこゆるはよふけて人のとふかとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "をしなへて野もせにおふる草の色は綠ふかくそなり增りける",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "野邊見れはみとりの草になりにけり變らぬ松の色はかりして",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "野へ見れは烟もたゝて春の日にもえいつるものは蕨なりけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花見にと人にはいひて春の野に立ましりつゝ藤をそおる",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さくら花さける盛りのやま里はそらよりふらぬ雪とこそみれ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "なかめつゝおるへき枝も見えぬまてびまなく咲る八重極かな",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "みる人はきしになみよる靑柳のいとに心をかけてこそくれ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "さほ姫のみなくれなゐにいはつゝしもえぬ計もそめてける哉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "河波のみとりの色にみえつるは岸の柳のかけにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "みな人のおのかひき〓〓せき入つゝまかする物は苗代の水",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "みるめなきあまのうき舟戀にのみこかれて物をおもふ比かな",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "みわたせはみな苗代におりたちてたみのいそかぬ里のなき哉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "思ひしる人もなきよにあちきなく戀にしにする名をや止めむ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "雲路わけこゝろからにて行雁のこのはるはかり歸らさらなん",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "行雁のみち見えぬまてしら雲の八重立かくせしはしとゝめん",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "出るよりこよひ計は弓はりの月は入まてのとけからなむ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "弓はりの月はのとかにみゆれとも入山のはのなからましかは",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "千代ふへき君か御代にはいとゝしくゐての山吹さきまさり鳬",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "咲きかすおほつかなきに山吹な〓らぬゐてなくたつれつる哉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
